{
  "_comment": "FeGenie-Evo operon rules \u2014 place this file in your --hmm_dir directory.",
  "report_all_categories": [
    "MetalResistance-*",
    "MetalAcquisition-*",
    "MetalHomeostasis-*",
    "MetalRegulation-*",
    "Iron-Storage",
    "Arsenic-Oxidation",
    "Unclassified-MetalFunction"
  ],
  "rules": [
    {
      "_comment": "FLEET electron shuttle: need \u22655 unique genes OR keep non-FLEET co-localisers",
      "name": "FLEET",
      "categories": [
        "Iron-Oxidation"
      ],
      "genes": [
        "EetA",
        "EetB",
        "Ndh2",
        "FmnB",
        "FmnA",
        "DmkA",
        "DmkB",
        "PplA"
      ],
      "rule": "require_n_of",
      "min_genes": 5,
      "on_fail": "passthrough_non_members",
      "canonical_size": 8,
      "max_bp_gap": 2000
    },
    {
      "_comment": "Magnetosome island: need \u22655 unique MAM genes",
      "name": "MAM",
      "categories": [
        "Magnetosome-Formation"
      ],
      "genes": [
        "MamA",
        "MamB",
        "MamE",
        "MamK",
        "MamP",
        "MamM",
        "MamQ",
        "MamI",
        "MamL",
        "MamO"
      ],
      "rule": "require_n_of",
      "min_genes": 5,
      "on_fail": "passthrough_non_members",
      "canonical_size": 10,
      "max_bp_gap": 3000
    },
    {
      "_comment": "FoxABC (Acidithiobacillus Fe-oxidation): need \u22652 of the three subunits",
      "name": "FOXABC",
      "categories": [
        "Iron-Oxidation"
      ],
      "genes": [
        "FoxA",
        "FoxB",
        "FoxC"
      ],
      "rule": "require_n_of",
      "min_genes": 2,
      "on_fail": "passthrough_non_members",
      "canonical_size": 3,
      "max_bp_gap": 1000
    },
    {
      "_comment": "FoxEYZ: FoxE (bc1-complex subunit) is the mandatory anchor gene",
      "name": "FOXEYZ",
      "categories": [
        "Iron-Oxidation"
      ],
      "genes": [
        "FoxE",
        "FoxY",
        "FoxZ"
      ],
      "rule": "require_anchor",
      "anchor": "FoxE",
      "on_fail": "passthrough_non_members",
      "canonical_size": 3,
      "max_bp_gap": 1000
    },
    {
      "_comment": "DFE operon 1 (Desulfosporosinus): need \u22653 of 4 subunits",
      "name": "DFE1",
      "categories": [
        "Iron-Reduction",
        "Iron-ReductionPotential"
      ],
      "genes": [
        "DFE_0448",
        "DFE_0449",
        "DFE_0450",
        "DFE_0451"
      ],
      "rule": "require_n_of",
      "min_genes": 3,
      "on_fail": "passthrough_non_members",
      "canonical_size": 4,
      "max_bp_gap": 1000
    },
    {
      "_comment": "DFE operon 2 (Desulfosporosinus): need \u22653 of 5 subunits",
      "name": "DFE2",
      "categories": [
        "Iron-Reduction",
        "Iron-ReductionPotential"
      ],
      "genes": [
        "DFE_0461",
        "DFE_0462",
        "DFE_0463",
        "DFE_0464",
        "DFE_0465"
      ],
      "rule": "require_n_of",
      "min_genes": 3,
      "on_fail": "passthrough_non_members",
      "canonical_size": 5,
      "max_bp_gap": 1000
    },
    {
      "_comment": "Mtr/Mto contextual disambiguation. ImoA is excluded: quinol oxidation/complementation does not establish native Fe(II) oxidation.",
      "name": "MtrMto",
      "categories": [
        "Iron-Oxidation",
        "Iron-Reduction",
        "Iron-RedoxPotential"
      ],
      "genes": [
        "MtrA",
        "MtrB_TIGR03509",
        "MtrC_TIGR03507",
        "MtoA"
      ],
      "rule": "mtr_disambiguation",
      "on_fail": "keep_all",
      "canonical_size": 3,
      "max_bp_gap": 2000
    },
    {
      "_comment": "Siderophore transport: need \u22652 distinct transport HMMs, OR a lone trusted receptor gene",
      "name": "SIDERO_TRANSPORT",
      "categories": [
        "Siderophore-TransportPotential",
        "Heme-Transport",
        "Siderophore-Transport",
        "IronAcquisition-ComplexTransport"
      ],
      "genes": [],
      "rule": "require_n_cat_or_lone_trusted",
      "min_genes": 2,
      "trusted_lone": [
        "FutA1-iron_ABC_transporter_iron-binding-rep",
        "FutA2-iron_ABC_transporter_iron-binding-rep",
        "FutC-iron_ABC_transporter_ATPase-rep",
        "LbtU-LvtA-PiuA-PirA-RhtA",
        "LbtU-LbtB-legiobactin_receptor",
        "LbtU_LbtB-legiobactin_receptor_2",
        "IroC-salmochelin_transport-rep"
      ],
      "on_fail": "drop",
      "max_bp_gap": 2000
    },
    {
      "_comment": "Siderophore biosynthesis: need \u22653 distinct synthesis HMMs in cluster",
      "name": "SIDERO_SYNTH",
      "categories": [
        "Siderophore-Synthesis"
      ],
      "genes": [],
      "rule": "require_n_cat",
      "min_genes": 3,
      "on_fail": "drop",
      "max_bp_gap": 5000
    },
    {
      "_comment": "Iron/heme transport: need \u22652 distinct transport HMMs in cluster",
      "name": "IRON_TRANSPORT",
      "categories": [
        "IronAcquisition-Transport",
        "Heme-Oxygenase"
      ],
      "genes": [],
      "rule": "require_n_cat",
      "min_genes": 2,
      "on_fail": "drop",
      "max_bp_gap": 2000
    },
    {
      "_comment": "Tad/Flp pilus (Chen et al. 2025, Nature, MISO): Flp pilin and CpaB assembly platform are obligate operon partners; either gene alone is a widespread, non-iron-specific adhesion/conjugation signal, so both are required",
      "name": "TAD_PILUS",
      "categories": [
        "Iron-Reduction"
      ],
      "genes": [
        "PF04964-Flp_Fap_pilin",
        "cpaB_TIGR03177.1"
      ],
      "rule": "require_n_of",
      "min_genes": 2,
      "on_fail": "passthrough_non_members",
      "canonical_size": 2,
      "max_bp_gap": 2000
    },
    {
      "_comment": "SUF operon (sufABCDSE): sufA/sufD/sufE have near-zero TC-NC calibration margin (confirmed: sufE cross-hits its non-operon paralog csdE at a comparable bitscore) and are marked needs_confirmation in the registry; require co-occurrence with at least 3 of the 6 SUF genes (in practice this means with the well-calibrated anchors sufB/sufC/sufS) before trusting a lone weak hit",
      "name": "SUF_OPERON",
      "categories": [
        "IronSulfur-Assembly"
      ],
      "genes": [
        "sufA_TIGR01997.1",
        "sufB_TIGR01980.1",
        "sufC_TIGR01978.1",
        "sufD_TIGR01981.1",
        "sufS_TIGR01979.1",
        "sufE_PF02657.22"
      ],
      "rule": "require_n_of",
      "min_genes": 3,
      "on_fail": "passthrough_non_members",
      "canonical_size": 6,
      "max_bp_gap": 2000
    },
    {
      "name": "CNT_CORE_K23120",
      "categories": [
        "Metallophore-Synthesis"
      ],
      "genes": [
        "K01780",
        "K23120",
        "K23122"
      ],
      "rule": "require_anchor",
      "anchor": "K23120",
      "on_fail": "passthrough_non_members",
      "max_bp_gap": 5000
    },
    {
      "name": "CNT_CORE_K23122",
