        "mbnA_TIGR04071",
        "mbnB_TIGR04159",
        "mbnC_TIGR04160"
      ],
      "rule": "require_anchor",
      "anchor": "mbnA_TIGR04071",
      "on_fail": "passthrough_non_members",
