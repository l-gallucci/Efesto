      "max_bp_gap": 5000
    },
    {
      "name": "MBN_CORE_TIGR04160",
      "categories": [
        "Metallophore-Synthesis"
      ],
      "genes": [
        "mbnA_TIGR04071",
        "mbnB_TIGR04159",
        "mbnC_TIGR04160"
      ],
      "rule": "require_anchor",
      "anchor": "mbnC_TIGR04160",
      "on_fail": "passthrough_non_members",
      "max_bp_gap": 5000
    }
  ]
}
