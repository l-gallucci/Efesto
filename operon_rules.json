{
  "_comment": "FeGenie-Evo operon rules — place this file in your --hmm_dir directory.",

  "report_all_categories": [
    "metal_resistance-*",
    "iron_storage"
  ],

  "rules": [
    {
      "_comment": "FLEET electron shuttle: need ≥5 unique genes OR keep non-FLEET co-localisers",
      "name":           "FLEET",
      "categories":     ["iron_oxidation"],
      "genes":          ["EetA","EetB","Ndh2","FmnB","FmnA","DmkA","DmkB","PplA"],
      "rule":           "require_n_of",
      "min_genes":      5,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 8,
      "max_bp_gap":     2000
    },
    {
      "_comment": "Magnetosome island: need ≥5 unique MAM genes",
      "name":           "MAM",
      "categories":     ["magnetosome_formation"],
      "genes":          ["MamA","MamB","MamE","MamK","MamP","MamM","MamQ","MamI","MamL","MamO"],
      "rule":           "require_n_of",
      "min_genes":      5,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 10,
      "max_bp_gap":     3000
    },
    {
      "_comment": "FoxABC (Acidithiobacillus Fe-oxidation): need ≥2 of the three subunits",
      "name":           "FOXABC",
      "categories":     ["iron_oxidation"],
      "genes":          ["FoxA","FoxB","FoxC"],
      "rule":           "require_n_of",
      "min_genes":      2,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 3,
      "max_bp_gap":     1000
    },
    {
      "_comment": "FoxEYZ: FoxE (bc1-complex subunit) is the mandatory anchor gene",
      "name":           "FOXEYZ",
      "categories":     ["iron_oxidation"],
      "genes":          ["FoxE","FoxY","FoxZ"],
      "rule":           "require_anchor",
      "anchor":         "FoxE",
      "on_fail":        "passthrough_non_members",
      "canonical_size": 3,
      "max_bp_gap":     1000
    },
    {
      "_comment": "DFE operon 1 (Desulfosporosinus): need ≥3 of 4 subunits",
      "name":           "DFE1",
      "categories":     ["iron_reduction","probable_iron_reduction"],
      "genes":          ["DFE_0448","DFE_0449","DFE_0450","DFE_0451"],
      "rule":           "require_n_of",
      "min_genes":      3,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 4,
      "max_bp_gap":     1000
    },
    {
      "_comment": "DFE operon 2 (Desulfosporosinus): need ≥3 of 5 subunits",
      "name":           "DFE2",
      "categories":     ["iron_reduction","probable_iron_reduction"],
      "genes":          ["DFE_0461","DFE_0462","DFE_0463","DFE_0464","DFE_0465"],
      "rule":           "require_n_of",
      "min_genes":      3,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 5,
      "max_bp_gap":     1000
    },
    {
      "_comment": "Mtr/Mto disambiguation: re-assigns iron_oxidation vs iron_reduction based on subunit co-presence",
      "name":           "MtrMto",
      "categories":     ["iron_oxidation","iron_reduction",
                         "possible_iron_oxidation_and_possible_iron_reduction"],
      "genes":          ["MtrA","MtrB_TIGR03509","MtrC_TIGR03507","MtoA","CymA"],
      "rule":           "mtr_disambiguation",
      "on_fail":        "keep_all",
      "canonical_size": 3,
      "max_bp_gap":     2000
    },
    {
      "_comment": "Siderophore transport: need ≥2 distinct transport HMMs, OR a lone trusted receptor gene",
      "name":       "SIDERO_TRANSPORT",
      "categories": ["iron_acquisition-siderophore_transport_potential",
                     "iron_acquisition-heme_transport",
                     "iron_acquisition-siderophore_transport"],
      "genes":      [],
      "rule":       "require_n_cat_or_lone_trusted",
      "min_genes":  2,
      "trusted_lone": [
        "FutA1-iron_ABC_transporter_iron-binding-rep",
        "FutA2-iron_ABC_transporter_iron-binding-rep",
        "FutC-iron_ABC_transporter_ATPase-rep",
        "LbtU-LvtA-PiuA-PirA-RhtA",
        "LbtU-LbtB-legiobactin_receptor",
        "LbtU_LbtB-legiobactin_receptor_2",
        "IroC-salmochelin_transport-rep"
      ],
      "on_fail":    "drop",
      "max_bp_gap": 2000
    },
    {
      "_comment": "Siderophore biosynthesis: need ≥3 distinct synthesis HMMs in cluster",
      "name":       "SIDERO_SYNTH",
      "categories": ["iron_acquisition-siderophore_synthesis"],
      "genes":      [],
      "rule":       "require_n_cat",
      "min_genes":  3,
      "on_fail":    "drop",
      "max_bp_gap": 5000
    },
    {
      "_comment": "Iron/heme transport: need ≥2 distinct transport HMMs in cluster",
      "name":       "IRON_TRANSPORT",
      "categories": ["iron_acquisition-iron_transport",
                     "iron_acquisition-heme_oxygenase"],
      "genes":      [],
      "rule":       "require_n_cat",
      "min_genes":  2,
      "on_fail":    "drop",
      "max_bp_gap": 2000
    },
    {
      "_comment": "Tad/Flp pilus (Chen et al. 2025, Nature, MISO): Flp pilin and CpaB assembly platform are obligate operon partners; either gene alone is a widespread, non-iron-specific adhesion/conjugation signal, so both are required",
      "name":           "TAD_PILUS",
      "categories":     ["iron_reduction"],
      "genes":          ["PF04964-Flp_Fap_pilin","cpaB_TIGR03177.1"],
      "rule":           "require_n_of",
      "min_genes":      2,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 2,
      "max_bp_gap":     2000
    },
    {
      "_comment": "SUF operon (sufABCDSE): sufA/sufD/sufE have near-zero TC-NC calibration margin (confirmed: sufE cross-hits its non-operon paralog csdE at a comparable bitscore) and are marked needs_confirmation in the registry; require co-occurrence with at least 3 of the 6 SUF genes (in practice this means with the well-calibrated anchors sufB/sufC/sufS) before trusting a lone weak hit",
      "name":           "SUF_OPERON",
      "categories":     ["iron_sulfur_assembly"],
      "genes":          ["sufA_TIGR01997.1","sufB_TIGR01980.1","sufC_TIGR01978.1",
                          "sufD_TIGR01981.1","sufS_TIGR01979.1","sufE_PF02657.22"],
      "rule":           "require_n_of",
      "min_genes":      3,
      "on_fail":        "passthrough_non_members",
      "canonical_size": 6,
      "max_bp_gap":     2000
    }
  ]
}
